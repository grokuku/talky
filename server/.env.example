# Talky — configuration du serveur de transcription (conteneur maison)
# Copier ce fichier en .env (à côté de docker-compose.yml) et adapter.

# --- Ports hôtes ------------------------------------------------------------
# REST : le client utilise server_url=http://<ip>:8000
TALKY_PORT=8000
# WebSocket temps réel : le client utilise ws_port=9090
TALKY_WS_PORT=9090

# --- Modèle / langue --------------------------------------------------------
# Modèle par défaut (alias faster-whisper) : large-v3-turbo, large-v3,
# medium, small, base, tiny…
TALKY_MODEL=large-v3-turbo
# Langue par défaut (vide = auto-détection). Ex : fr, en, de…
TALKY_LANGUAGE=fr

# --- Précision / VAD --------------------------------------------------------
# compute_type faster-whisper : int8 (défaut), int8_float16, float16, float32
TALKY_COMPUTE_TYPE=int8
# Seuil de détection de parole Silero (0.0-1.0, défaut 0.5)
TALKY_VAD_THRESHOLD=0.5
# Silence requis pour finaliser une phrase (ms, défaut 500)
TALKY_VAD_SILENCE_MS=500

# --- Concurrence / logs -----------------------------------------------------
TALKY_MAX_CLIENTS=4
TALKY_LOG_LEVEL=INFO

# --- Authentification (optionnelle) ------------------------------------------
# Si non vide, exige `Authorization: Bearer <clé>` sur REST + handshake WS.
# Vide = aucune authentification (usage LAN privé).
TALKY_API_KEY=

# --- Origines WebSocket autorisées (côté CLIENT, panneau web) ----------------
# Liste CSV d'origines supplémentaires acceptées par le WebSocket /ws du client
# (ex. accès LAN : http://192.168.1.50:8000). 127.0.0.1:8000 et localhost:8000
# sont toujours acceptés.
TALKY_ALLOWED_ORIGINS=

# --- Cache des modèles (hôte) -----------------------------------------------
# Sur Unraid : /mnt/user/appdata/talky/hf-hub-cache
HF_CACHE_PATH=./hf-hub-cache
